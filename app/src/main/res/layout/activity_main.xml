<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintWidth_max="460dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/logo_badge"
            android:contentDescription="Bubbl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bubbl"
            android:textColor="@color/on_surface"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque no balão. Zoom na hora."
            android:textColor="@color/on_surface_muted"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Abrir arquivo"
            android:textSize="16sp"
            android:paddingVertical="16dp"
            app:icon="@drawable/ic_file"
            app:iconGravity="textStart"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFolder"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Abrir pasta de imagens"
            android:textSize="16sp"
            android:paddingVertical="16dp"
            app:icon="@drawable/ic_folder"
            app:iconGravity="textStart"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CBZ · CBR · PDF · EPUB · Imagens"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="28dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/violet" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
